# LabBrain settings: settings about you, not about the wiki. See docs/configuration.md.
#
# Copy this file to env/.env and fill in what you need. env/.env is ignored by git.
# An empty value means "not set". A variable set in your shell wins over this file.
# To keep the file somewhere else, set LABBRAIN_ENV=<path> in your shell.

# The person whose notes these are: the default for `labbrain frontmatter --by`.
# Written as human:<name>, e.g. human:ada. Never an email address.
LABBRAIN_CONTRIBUTOR=

# The wiki to use when you run labbrain outside one: the folder whose index.md declares
# okf_version, as an absolute path or starting with ~. Inside a wiki, the wiki you're in wins.
LABBRAIN_VAULT=

# Whether agents may add metadata (such as a description) to the header of your notes: true or
# false. Empty means false. When true, `labbrain frontmatter` writes `annotate: true` into the
# header of each new note signed as LABBRAIN_CONTRIBUTOR, never into anyone else's. Your notes'
# text is never touched either way.
LABBRAIN_ANNOTATE=
